rules_version = '2';

// Paste this into Firebase Console → Firestore Database → Rules, replacing
// the test-mode rules, before sharing the site's URL with anyone.
//
// This app has no login system (just a client-side PIN gate on the front
// end), so these rules cannot tell "us" apart from a stranger who found the
// URL — they only constrain the *shape* of writes so a bot or scraper can't
// trash the database. See README.md for how to raise the bar further with
// Firebase App Check.

service cloud.firestore {
  match /databases/{database}/documents {

    match /photos/{photoId} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(
                        ['url', 'publicId', 'width', 'height', 'uploadedBy', 'createdAt']
                      )
                      && request.resource.data.url is string
                      && request.resource.data.url.startsWith('https://res.cloudinary.com/z0pt1gga/')
                      && request.resource.data.uploadedBy is string
                      && request.resource.data.uploadedBy.size() < 40;
      allow update, delete: if false;
    }

    match /quotes/{quoteId} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['text', 'author', 'createdAt'])
                      && request.resource.data.text is string
                      && request.resource.data.text.size() > 0
                      && request.resource.data.text.size() < 500;
      allow update, delete: if false;
    }

    match /songs/{songId} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['title', 'artist', 'url', 'createdAt'])
                      && request.resource.data.title is string
                      && request.resource.data.title.size() < 200
                      && request.resource.data.url is string
                      && (request.resource.data.url.startsWith('https://open.spotify.com/')
                          || request.resource.data.url.startsWith('https://www.youtube.com/')
                          || request.resource.data.url.startsWith('https://youtu.be/'));
      allow update, delete: if false;
    }

    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
