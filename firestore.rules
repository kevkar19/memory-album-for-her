rules_version = '2';

// Paste this into Firebase Console → Firestore Database → Rules, replacing
// the test-mode rules, before sharing the site's URL with anyone.
//
// Note: uses .matches() instead of .startsWith() for prefix checks —
// .startsWith() silently failed (denied every request) on this project's
// rules environment for reasons never fully diagnosed; .matches() with an
// escaped-dot regex is the fallback that reliably works.
//
// This app has no login system (just a client-side PIN gate on the front
// end), so these rules cannot tell "us" apart from a stranger who found the
// URL — they only constrain the *shape* of creates/edits so a bot or
// scraper can't fill the database with junk. Deletes are intentionally
// left open (see below) so either of you can remove a photo from the app,
// which also means a stranger who found the URL could delete photos too.
// See README.md for how to raise the bar further with Firebase App Check.

service cloud.firestore {
  match /databases/{database}/documents {

    function isMusicUrl(url) {
      return url.matches('^https://open[.]spotify[.]com/.*')
        || url.matches('^https://www[.]youtube[.]com/.*')
        || url.matches('^https://youtu[.]be/.*');
    }

    match /photos/{photoId} {
      allow read: if true;

      // Creating a photo: only via the app's upload flow, so the image
      // itself always comes from our Cloudinary account. `caption` is the
      // photo's title, `subcaption` is the smaller quote/caption under it,
      // `songStart` is the second offset for the 20-second YouTube loop.
      allow create: if request.resource.data.keys().hasOnly(
                        ['url', 'publicId', 'width', 'height', 'uploadedBy', 'caption', 'subcaption', 'songUrl', 'songStart', 'createdAt']
                      )
                      && request.resource.data.url is string
                      && request.resource.data.url.matches('^https://res[.]cloudinary[.]com/z0pt1gga/.*')
                      && request.resource.data.uploadedBy is string
                      && request.resource.data.uploadedBy.size() < 40
                      && (!('caption' in request.resource.data) || request.resource.data.caption == null
                          || (request.resource.data.caption is string && request.resource.data.caption.size() < 120))
                      && (!('subcaption' in request.resource.data) || request.resource.data.subcaption == null
                          || (request.resource.data.subcaption is string && request.resource.data.subcaption.size() < 300))
                      && (!('songUrl' in request.resource.data) || request.resource.data.songUrl == null
                          || (request.resource.data.songUrl is string && isMusicUrl(request.resource.data.songUrl)))
                      && (!('songStart' in request.resource.data) || request.resource.data.songStart == null
                          || (request.resource.data.songStart is int && request.resource.data.songStart >= 0
                              && request.resource.data.songStart < 36000));

      // Editing a photo: only caption/subcaption/songUrl/songStart/favorite
      // may change — the image, uploader, and timestamp are immutable once
      // created.
      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['caption', 'subcaption', 'songUrl', 'songStart', 'favorite'])
                      && (!('caption' in request.resource.data) || request.resource.data.caption == null
                          || (request.resource.data.caption is string && request.resource.data.caption.size() < 120))
                      && (!('subcaption' in request.resource.data) || request.resource.data.subcaption == null
                          || (request.resource.data.subcaption is string && request.resource.data.subcaption.size() < 300))
                      && (!('songUrl' in request.resource.data) || request.resource.data.songUrl == null
                          || (request.resource.data.songUrl is string && isMusicUrl(request.resource.data.songUrl)))
                      && (!('songStart' in request.resource.data) || request.resource.data.songStart == null
                          || (request.resource.data.songStart is int && request.resource.data.songStart >= 0
                              && request.resource.data.songStart < 36000))
                      && (!('favorite' in request.resource.data) || request.resource.data.favorite is bool);

      // Deleting a photo: open, by request — this app has no real auth, so
      // this also means anyone with the site URL could delete photos, not
      // just the two of you. Acceptable trade-off behind the PIN gate for
      // a small shared album; revisit with Firebase Auth if that changes.
      allow delete: if true;
    }

    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
