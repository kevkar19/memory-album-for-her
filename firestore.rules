rules_version = '2';

// Paste this into Firebase Console → Firestore Database → Rules, replacing
// the test-mode rules, before sharing the site's URL with anyone.
//
// This app has no login system (just a client-side PIN gate on the front
// end), so these rules cannot tell "us" apart from a stranger who found the
// URL — they only constrain the *shape* of writes so a bot or scraper can't
// trash the database. See README.md for how to raise the bar further with
// Firebase App Check.

service cloud.firestore {
  match /databases/{database}/documents {

    function isMusicUrl(url) {
      return url.startsWith('https://open.spotify.com/')
        || url.startsWith('https://www.youtube.com/')
        || url.startsWith('https://youtu.be/');
    }

    match /photos/{photoId} {
      allow read: if true;

      // Creating a photo: only via the app's upload flow, so the image
      // itself always comes from our Cloudinary account.
      allow create: if request.resource.data.keys().hasOnly(
                        ['url', 'publicId', 'width', 'height', 'uploadedBy', 'caption', 'songUrl', 'createdAt']
                      )
                      && request.resource.data.url is string
                      && request.resource.data.url.startsWith('https://res.cloudinary.com/z0pt1gga/')
                      && request.resource.data.uploadedBy is string
                      && request.resource.data.uploadedBy.size() < 40
                      && (!('caption' in request.resource.data) || request.resource.data.caption == null
                          || (request.resource.data.caption is string && request.resource.data.caption.size() < 300))
                      && (!('songUrl' in request.resource.data) || request.resource.data.songUrl == null
                          || (request.resource.data.songUrl is string && isMusicUrl(request.resource.data.songUrl)));

      // Editing a photo: only the caption/songUrl may change — the image,
      // uploader, and timestamp are immutable once created.
      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['caption', 'songUrl'])
                      && (!('caption' in request.resource.data) || request.resource.data.caption == null
                          || (request.resource.data.caption is string && request.resource.data.caption.size() < 300))
                      && (!('songUrl' in request.resource.data) || request.resource.data.songUrl == null
                          || (request.resource.data.songUrl is string && isMusicUrl(request.resource.data.songUrl)));

      allow delete: if false;
    }

    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
